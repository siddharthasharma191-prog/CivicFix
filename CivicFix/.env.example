# Template only: CivicFix does NOT automatically load .env files.
# Set variables directly in your terminal or hosting environment.
PORT=3000
NODE_ENV=development
# Optional. Relative paths resolve from the process working directory.
CIVICFIX_DB_PATH=./data/civicfix.sqlite
# Required to enable admin login; choose a private password of at least 12 characters.
# CIVICFIX_ADMIN_PASSWORD=replace-with-your-own-private-password
# Required to enable signed sessions; use at least 32 random bytes (64 hex characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CIVICFIX_SESSION_SECRET=replace-with-a-random-secret
# Optional when deployed behind a reverse proxy; set the exact public origin, e.g. https://civicfix.example.org
# CIVICFIX_PUBLIC_ORIGIN=https://your-public-origin.example
